{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Backend (uv)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
        }
    ]
}
